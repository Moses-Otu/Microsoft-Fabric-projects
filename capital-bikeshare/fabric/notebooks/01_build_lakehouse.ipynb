    "                             'last_trip_date': 'Date of the last trip that started or ended here in 2011–2012.'}},\n",
    " 'fact_trips': {'table': \"One row per trip in Capital Bikeshare's public 2011 and 2012 trip files. The operator removes staff trips, \"\n",
    "                         'test-station trips and trips under 60 seconds, so totals are about 1% below the UCI daily counts.',\n",
    "                'columns': {'trip_id': 'Row number assigned at load, in start-time order.',\n",
    "                            'start_datetime': 'When the trip started (local time).',\n",
    "                            'end_datetime': 'When the trip ended (local time).',\n",
    "                            'duration_sec': 'Trip length in seconds, as published.',\n",
    "                            'duration_min': 'Trip length in minutes.',\n",
    "                            'start_station_key': 'Start station. Active relationship to dim_station.',\n",
    "                            'end_station_key': \"End station. Inactive relationship to dim_station, used by the 'ended' and 'arrivals' \"\n",
    "                                               'measures.',\n",
    "                            'bike_number': 'Bike identifier. Hidden from the Region viewers role.',\n",
    "                            'member_type': 'Member, Casual or Unknown.',\n",
    "                            'start_date': 'Date the trip started. Relationship to dim_date.',\n",
    "                            'start_hour': 'Hour the trip started, 0 to 23. Relationship to dim_hour.',\n",
    "                            'is_round_trip': 'True when the trip started and ended at the same station.'}},\n",
    " 'fact_daily_rentals': {'table': 'Daily rental totals from the UCI Bike Sharing dataset (Capital Bikeshare, 2011–2012). The reference for '\n",
    "                                 'city-wide daily counts and weather analysis.',\n",
    "                        'columns': {'date': 'Date. Relationship to dim_date.',\n",
    "                                    'casual': 'Rentals by casual riders.',\n",
    "                                    'registered': 'Rentals by registered members.',\n",
    "                                    'total': 'All rentals.'}},\n",
    " 'fact_hourly_rentals': {'table': \"Hourly rental totals from the UCI Bike Sharing dataset, with that hour's weather.\",\n",
    "                         'columns': {'date': 'Date. Relationship to dim_date.',\n",
    "                                     'hour': 'Hour, 0 to 23. Relationship to dim_hour.',\n",
    "                                     'casual': 'Rentals by casual riders.',\n",
    "                                     'registered': 'Rentals by registered members.',\n",
    "                                     'total': 'All rentals.',\n",
    "                                     'weather_code': 'UCI weather situation code for the hour.',\n",
    "                                     'weather': 'Weather in that hour.',\n",
    "                                     'temp_c': 'Temperature, °C.',\n",
    "                                     'feels_like_c': \"'Feels like' temperature, °C.\",\n",
    "                                     'humidity_pct': 'Humidity, %.',\n",
    "                                     'wind_speed': 'Wind speed (UCI normalised value × 67).'}},\n",
    " 'security_user_region': {'table': 'Who may see which region, for row-level security. One row per person per region. Hidden in the model.',\n",
    "                          'columns': {'user_email': \"The person's sign-in (user principal name), in lower case.\",\n",
    "                                      'region_name': 'A region_name from dim_station they may see.'}}}\n",
    "\n",
    "from pyspark.sql import functions as F\n",
    "spark.conf.set(\"spark.sql.execution.arrow.pyspark.enabled\", \"true\")\n",
    "spark.conf.set(\"spark.sql.session.timeZone\", \"UTC\")   # keep local times exactly as published\n",
    "\n",
    "DATE_COLUMNS = {\"dim_date\": [\"date\"], \"dim_station\": [\"first_trip_date\", \"last_trip_date\"], \"fact_trips\": [\"start_date\"],\n",
    "                \"fact_daily_rentals\": [\"date\"], \"fact_hourly_rentals\": [\"date\"]}\n",
    "\n",
    "def to_plain(pdf):\n",
    "    out = pdf.copy()\n",
    "    for c in out.columns:\n",
    "        dt = str(out[c].dtype)\n",
    "        if dt == \"Int64\":\n",
    "            out[c] = out[c].astype(\"int64\") if not out[c].isna().any() else out[c].astype(\"float64\")\n",
    "        elif dt == \"boolean\":\n",
    "            out[c] = out[c].fillna(False).astype(bool)\n",
    "        elif dt.startswith(\"string\"):\n",
    "            out[c] = out[c].astype(object).where(out[c].notna(), None)\n",
    "        elif dt.startswith(\"datetime64\"):\n",
    "            out[c] = out[c].astype(\"datetime64[ns]\")\n",
    "    return out\n",
    "\n",
    "def sql_text(s):\n",
    "    return s.replace(\"\\\\\", \"\\\\\\\\\").replace(\"'\", \"\\\\'\")\n",
    "\n",
    "for name, pdf in gold.items():\n",
    "    sdf = spark.createDataFrame(to_plain(pdf))\n",
    "    for c in DATE_COLUMNS.get(name, []):\n",
    "        sdf = sdf.withColumn(c, F.to_date(c))\n",
    "    sdf.write.mode(\"overwrite\").option(\"overwriteSchema\", \"true\").format(\"delta\").saveAsTable(name)\n",
    "    d = DESCRIPTIONS[name]\n",
    "    try:\n",
    "        spark.sql(f\"COMMENT ON TABLE {name} IS '{sql_text(d['table'])}'\")\n",
    "        for col, text in d[\"columns\"].items():\n",
    "            spark.sql(f\"ALTER TABLE {name} ALTER COLUMN {col} COMMENT '{sql_text(text)}'\")\n",
    "    except Exception as e:\n",
    "        print(f\"  (descriptions not written for {name}: {e})\")\n",
    "    print(f\"wrote {name}\")"
   ]
